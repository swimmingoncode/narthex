{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narthex.dev/contracts/data-model/trace.schema.json",
  "title": "Trace export",
  "description": "A project's items and trace links as a needs.json-compatible file (REQ-DAT-20, ASM-26, SPEC 6.3 and 6.4). The shape is that of the sphinx-needs export: versions, then needs keyed by identifier. Each need has an id, a type, a title, a status, its links and its source location. `links` lists every identifier the need points at; the typed arrays say how, one per link type of SPEC 6.4. `id`, the link targets and `source` are the definitions of `spec-item.schema.json`, so an item reads the same in both. The schema checks the shape; that each key equals its need's id and that needs_amount counts the needs belongs to the conformance suite.",
  "type": "object",
  "required": ["project", "current_version", "versions"],
  "properties": {
    "created": { "type": "string" },
    "project": { "type": "string", "minLength": 1 },
    "current_version": { "type": "string" },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/version" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "object",
      "required": ["needs_amount", "needs"],
      "properties": {
        "created": { "type": "string" },
        "needs_amount": { "type": "integer", "minimum": 0 },
        "needs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/need" }
        }
      },
      "additionalProperties": false
    },
    "need": {
      "type": "object",
      "required": ["id", "type", "title", "status", "links", "source"],
      "properties": {
        "id": { "$ref": "spec-item.schema.json#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "title": { "type": "string" },
        "status": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "links": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "derives-from": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "mitigates": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "allocated-to": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "decided-by": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "implemented-by": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "verified-by": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "evidenced-by": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "amended-by": { "$ref": "spec-item.schema.json#/$defs/ids" },
        "source": { "$ref": "spec-item.schema.json#/$defs/source" }
      },
      "additionalProperties": false
    }
  }
}
