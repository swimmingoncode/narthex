{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narthex.dev/contracts/data-model/questions.schema.json",
  "title": "Questions file",
  "description": "decisions/questions.json: the form, its sections and its items (REQ-DEC-1, REQ-DEC-43). Structure only: cross-references between items (follows, superseded_by, before, for), unique ids and the style limits are checked by the builder.",
  "type": "object",
  "required": ["form", "sections", "items"],
  "properties": {
    "form": { "$ref": "#/$defs/form" },
    "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "text": { "type": "string", "minLength": 1 },
    "form": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "collection": { "$ref": "#/$defs/text" },
        "specBase": { "$ref": "#/$defs/text" },
        "specName": { "$ref": "#/$defs/text" },
        "overviewBlurb": { "type": "string" },
        "sectionOrder": { "const": "as-written" },
        "brand": { "$ref": "#/$defs/brand" }
      },
      "additionalProperties": false
    },
    "hex": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "palette": {
      "type": "object",
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "card": { "$ref": "#/$defs/hex" },
        "ink": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "line": { "$ref": "#/$defs/hex" },
        "chip": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accentInk": { "$ref": "#/$defs/hex" }
      },
      "additionalProperties": false
    },
    "fontList": { "type": "string", "pattern": "^[^/@;{}<>\\\\]*$", "minLength": 1 },
    "brand": {
      "type": "object",
      "properties": {
        "fontsUrl": {
          "type": "string",
          "pattern": "^https://fonts\\.googleapis\\.com/[^\\s\"<>]*$"
        },
        "fonts": {
          "type": "object",
          "properties": {
            "body": { "$ref": "#/$defs/fontList" },
            "mono": { "$ref": "#/$defs/fontList" }
          },
          "additionalProperties": false
        },
        "light": { "$ref": "#/$defs/palette" },
        "dark": { "$ref": "#/$defs/palette" },
        "logo": {
          "oneOf": [
            { "type": "string", "pattern": "\\.[sS][vV][gG]$" },
            {
              "type": "object",
              "required": ["light"],
              "properties": {
                "light": { "type": "string", "pattern": "\\.[sS][vV][gG]$" },
                "dark": { "type": "string", "pattern": "\\.[sS][vV][gG]$" }
              },
              "additionalProperties": false
            }
          ]
        },
        "favicon": { "type": "string", "pattern": "\\.(?:[sS][vV][gG]|[pP][nN][gG])$" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["id", "title"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" } },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "blurb": { "type": "string" },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
      },
      "additionalProperties": false
    },
    "ref": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "url": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "chainStep": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "url": { "type": ["string", "null"] },
        "why": { "type": "string" },
        "before": { "type": "array", "items": { "type": "string" } },
        "for": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "section", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["decide", "act", "queue", "read", "update", "later"] },
        "section": { "$ref": "#/$defs/id" },
        "group": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "lead": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "rec": { "type": "string" },
        "options": {
          "type": "array",
          "prefixItems": [{ "type": "string" }],
          "items": { "type": "string", "not": { "pattern": "\\(recommended\\)" } }
        },
        "default": { "type": "integer", "minimum": 0 },
        "reserved": { "type": "boolean" },
        "blocks": { "type": "boolean" },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "chain": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chainStep" } },
        "spec": { "type": "array", "items": { "type": "string" } },
        "keep_open": { "type": "boolean" },
        "applied": { "type": "string" },
        "superseded_by": { "type": "string" },
        "follows": { "type": "string" },
        "origin": { "type": "string" }
      },
      "additionalProperties": false,
      "dependentSchemas": {
        "chain": { "required": ["kind"], "properties": { "kind": { "const": "read" } } }
      },
      "if": { "required": ["reserved"], "properties": { "reserved": { "const": true } } },
      "then": { "properties": { "default": false } }
    }
  }
}
