{
  "name": "narthex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p contracts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:act-items": "node scripts/check-act-items.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries",
    "test:scripts": "node --test \"tests/*.test.mjs\" \"scripts/*.test.mjs\"",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test": "npm run test:scripts && npm run test:contracts && npm run test:workspaces",
    "test:contracts": "node --test \"contracts/*/tests/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.9.0"
  }
}
